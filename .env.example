# Copy to `.env.local` and fill in values. See README "Local development" and
# docs/email-ledger-and-gmail.md for full context.

# ─── SDP wallet integration (SEP-10 client_domain + SEP-24 recipient registration) ───
# Comma-separated hostnames of SDP instances whose stellar.toml this wallet may fetch.
# Include every partner/anchor SDP host. Required before accepting any invite links.
# Production Railway testnet example:
# SDP_ALLOWED_DOMAINS=sdp-v2-production-f6c7.up.railway.app
# SDP_ALLOWED_DOMAINS=sdp.example.com,localhost:8080

# ─── Environment-specific URLs (required for passkey origin binding) ─────────
# These MUST differ between Production and Staging due to WebAuthn RP ID constraints.
# See docs/deployment.md and docs/agents/git-flow.md.

# Production (main → app.sozu.capital):
# NEXT_PUBLIC_APP_URL=https://app.sozu.capital
# NEXT_PUBLIC_RP_ID=app.sozu.capital
# WALLET_CLIENT_DOMAIN=app.sozu.capital

# Staging (dev → dev.sozu.capital):
# NEXT_PUBLIC_APP_URL=https://dev.sozu.capital
# NEXT_PUBLIC_RP_ID=dev.sozu.capital
# WALLET_CLIENT_DOMAIN=dev.sozu.capital

# Local / ngrok:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_RP_ID=localhost
# WALLET_CLIENT_DOMAIN=localhost

# Hostname Sozu publishes as client_domain in SEP-10. No scheme.
# WALLET_CLIENT_DOMAIN=app.sozu.capital

# Stellar secret key whose public key is published in /.well-known/stellar.toml as SIGNING_KEY.
# Used only server-side to add the client-domain signature to SEP-10 challenges.
# Generate a dedicated testnet keypair: node -e "const {Keypair}=require('@stellar/stellar-sdk');const k=Keypair.random();console.log(k.publicKey(),k.secret())"
# Fund it on testnet: https://laboratory.stellar.org/#account-creator
# SEP10_CLIENT_SIGNING_SECRET=S...

# Optional: override the SDP deep link path (default /sdp/invite)
# SDP_INVITE_PATHNAME=/sdp/invite

# Multi-tenant SDP (Railway): tenant name for SDP-Tenant-Name header and wallet-registration URLs.
# Must match the tenant created in SDP admin (e.g. mujeres-admin).
# SDP_TENANT_NAME=mujeres-admin

# SDP admin API (server-only) — same values as SozuPay dashboard / Vercel sozupay_mvp.
# Used for Debug SDP batch_lookup on verify failure. Copy from SozuPay_dashboard/.env.local
# or Railway → sdp-api public URL + NGO operator login (not TODO placeholders).
# SDP_API_URL=https://sdp-v2-production-f6c7.up.railway.app
# SDP_ADMIN_EMAIL=
# SDP_ADMIN_PASSWORD=
# SDP_ADMIN_API_KEY=   # Railway ADMIN_API_KEY — for scripts/sdp-list-tenants.mjs only

# Optional: DOCUMENTATION URL in wallet stellar.toml
# WALLET_DOCUMENTATION_URL=https://app.sozu.capital

# Allow /api/debug/* and /api/test/* outside Preview (Staging may set true).
# ALLOW_DEBUG_ROUTES=false

# ─── Soroban smart accounts (default wallet + USDC sends) ───
# Same factory as SozuPay dashboard when sharing Supabase + Stellar testnet.
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# SMART_ACCOUNT_FACTORY_ID=
# SMART_ACCOUNT_FACTORY_METHOD=create_account
# SMART_ACCOUNT_GET_ADDRESS_VIEW=get_address
# STELLAR_FUNDER_SECRET=   # factory deploy + Soroban balance simulation source (required for C BlendUSDC reads)
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# BlendUSDC (sends) — MUST start with C (56 chars). Missing C is auto-fixed in code.
# TESTNET_USDC_CONTRACT_ADDRESS=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
# NOT the Circle SAC id — Stellar Expert may show SAC separately in the balance audit.
# Circle USDC SAC on C (auto-derived from issuer; override only if needed)
# TESTNET_CIRCLE_USDC_SAC_CONTRACT_ADDRESS=
# CIRCLE_TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ─── Sozu Faucet (testnet MVP — NFC orbs at /faucet/[slug]) ──────────────────
# Deployed Sozu Faucet vault contract (contracts/faucet). When set, claims are
# paid by invoking claim(to, amount) on this contract (admin = treasury G).
# FAUCET_CONTRACT_ID=
# Treasury G secret: contract admin + fallback direct-transfer sender.
# Falls back to STELLAR_FUNDER_SECRET when unset (testnet only).
# FAUCET_TREASURY_SECRET=
# Token for the fallback direct-transfer rail; defaults to Circle USDC SAC.
# FAUCET_TOKEN_CONTRACT_ID=
# Per-wallet cooldown in hours (default 24). Set 0 to disable — TESTING ONLY.
# FAUCET_USER_COOLDOWN_HOURS=
# Global per-faucet cooldown in minutes; overrides the DB cooldown_minutes. 0 disables.
# FAUCET_GLOBAL_COOLDOWN_MINUTES=
# Daily faucet budget in USDC; overrides the DB daily_limit.
# FAUCET_DAILY_LIMIT=
# Override the per-claim amount in whole USDC (else the faucets DB row is used).
# Must not exceed on-chain vault balance (see ./scripts/faucet-vault.sh balance).
# FAUCET_CLAIM_AMOUNT=1
# Salt for hashing IP / user-agent abuse signals in faucet_claims.
# FAUCET_HASH_SALT=

# OpenZeppelin passkey smart accounts (same as SozuPay dashboard testnet)
# OZ_SMART_ACCOUNT_WASM_HASH_TESTNET=3e51f5b222dec74650f0b33367acb42a41ce497f72639230463070e666abba2c
# OZ_WEBAUTHN_VERIFIER_CONTRACT_ID_TESTNET=CATPTBRWVMH5ZCIKO5HN2F4FMPXVZEXC56RKGHRXCM7EEZGGXK7PICEH
# OZ_THRESHOLD_POLICY_CONTRACT_ID_TESTNET=CDDQLFG7CV74QHWPSP6NZIPNBR2PPCMTUVYCJF4P3ONDYHODRFGR7LWC
# STELLAR_NETWORK=testnet

# ─── Deployment tier + fiat deposit rail ──────────────────────────────────────
# Target model: one Vercel project with Staging (dev) + Production (main).
# See docs/deployment.md. Legacy two-domain notes: docs/deployment-two-domains.md.

# Which beta tier this deployment serves.
# "closed" = Sozu Wallet (app.sozu.capital / dev.sozu.capital) — deposits on
# "open"   = legacy credit.sozu.capital posture (wallet/DeFi only; deposits hidden)
# NEXT_PUBLIC_BETA_TIER=closed

# Enable CLP deposits (bank + card). BOTH are needed for the deposit modal fiat tab:
# NEXT_PUBLIC_* is inlined for client UI; DEPOSITS_ENABLED is read on the server.
# DEPOSITS_ENABLED=true
# NEXT_PUBLIC_DEPOSITS_ENABLED=true

# CLP/USDC fallback when live oracle is unreachable (1 USDC = X CLP).
# Live rate: mindicador.cl + optional Frankfurter; see lib/deposits/clp-oracle.ts.
# DEPOSIT_FX_CLP_PER_USDC=950

# Spread in basis points added to spot rate (default 100 = 1%).
# DEPOSIT_FX_SPREAD_BPS=100

# Bank account details shown to users for CLP wire transfers.
# All four are required when DEPOSITS_ENABLED=true.
# SOZU_CLP_BANK_NAME=Sozu Capital SpA
# SOZU_CLP_BANK_ACCOUNT=00-000-00000-00
# SOZU_CLP_BANK_RUT=12.345.678-9
# SOZU_CLP_BANK_EMAIL=depositos@sozu.capital

# Phase 5: CLP threshold below which card deposits may be auto-released.
# Bank transfers always require manual admin review.
# BETA_AUTO_RELEASE_LIMIT_CLP=500000

# --- SumUp card deposits (closed beta / app.sozu.capital) ---
# SECRET key only (sup_sk_…). Do NOT use the public key (sup_pk_).
# SumUp → me.sumup.com → Settings → For Developers → API Keys → Create
# SUMUP_API_KEY=sup_sk_...
# SUMUP_MERCHANT_CODE=ML7X96UP
# Optional: only for SumUp Webhooks product when x-payload-signature is sent.
# Checkout return_url callbacks often work WITHOUT this — leave unset for local dev.
# Do NOT paste cc_sk_classic OAuth secrets here unless SumUp docs say it's the webhook signing secret.
# SUMUP_WEBHOOK_SECRET=
# Optional overrides (defaults derived from NEXT_PUBLIC_APP_URL):
# SUMUP_WEBHOOK_URL=https://app.sozu.capital/api/deposits/sumup/webhook
# SUMUP_REDIRECT_URL=https://app.sozu.capital/deposit/return

# --- Gmail OAuth (Settings → Link Gmail) ---
# Client ID from Google Cloud (either name works):
GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# Required for /api/gmail/callback token exchange (either name works):
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET=

# Optional. If unset, redirect URI is built as {origin}/api/gmail/callback.
# When set, it must exactly match an Authorized redirect URI on the OAuth client.
# GOOGLE_REDIRECT_URI=https://credit.sozu.capital/api/gmail/callback

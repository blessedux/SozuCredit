# Copy to `.env.local` and fill in values. See README "Local development" and
# docs/email-ledger-and-gmail.md for full context.

# ─── SDP wallet integration (SEP-10 client_domain + SEP-24 recipient registration) ───
# Comma-separated hostnames of SDP instances whose stellar.toml this wallet may fetch.
# Include every partner/anchor SDP host. Required before accepting any invite links.
# SDP_ALLOWED_DOMAINS=sdp.example.com,localhost:8080

# Hostname Sozu publishes as client_domain in SEP-10. No scheme.
# In production: credit.sozu.capital
# In local dev: your ngrok tunnel hostname (e.g. abc123.ngrok-free.app)
# WALLET_CLIENT_DOMAIN=credit.sozu.capital

# Stellar secret key whose public key is published in /.well-known/stellar.toml as SIGNING_KEY.
# Used only server-side to add the client-domain signature to SEP-10 challenges.
# Generate a dedicated testnet keypair: node -e "const {Keypair}=require('@stellar/stellar-sdk');const k=Keypair.random();console.log(k.publicKey(),k.secret())"
# Fund it on testnet: https://laboratory.stellar.org/#account-creator
# SEP10_CLIENT_SIGNING_SECRET=S...

# Optional: override the SDP deep link path (default /sdp/invite)
# SDP_INVITE_PATHNAME=/sdp/invite

# Optional: DOCUMENTATION URL in wallet stellar.toml
# WALLET_DOCUMENTATION_URL=https://credit.sozu.capital

# --- Gmail OAuth (Settings → Link Gmail) ---
# Client ID from Google Cloud (either name works):
GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# Required for /api/gmail/callback token exchange (either name works):
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET=

# Optional. If unset, redirect URI is built as {origin}/api/gmail/callback.
# When set, it must exactly match an Authorized redirect URI on the OAuth client.
# GOOGLE_REDIRECT_URI=https://credit.sozu.capital/api/gmail/callback
